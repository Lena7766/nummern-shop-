    .btn { display:inline-block; background:var(--accent); color:white; padding:16px 28px; border-radius:12px; text-decoration:none; font-weight:700; font-size:16px; transition:0.2s; margin:8px; }
    .btn:hover { transform:translateY(-2px); box-shadow:0 5px 15px rgba(37,211,102,0.4); }
    .sticky-btn { position:fixed; bottom:20px; right:20px; background:var(--accent); color:white; padding:15px 20px; border-radius:50px; font-weight:700; box-shadow:0 5px 20px rgba(0,0,0,0.2); z-index:999; text-decoration:none; }
    
    .pakete { display:grid; grid-template-columns:repeat(3, 1fr); gap:20px; }
    .paket-card { border:2px solid #eee; border-radius:15px; padding:25px; text-align:center; transition:0.3s; }
    .paket-card:hover { border-color:var(--vodafone); transform:translateY(-5px); }
    .paket-card h3 { color:var(--vodafone); margin-bottom:10px; }
    .preis { font-size:36px; font-weight:800; color:var(--green); }
    .vorwahl { font-size:20px; font-weight:700; color:#333; background:#F1F8E9; padding:10px; border-radius:8px; margin:15px 0; }

    footer { text-align:center; padding:30px; font-size:13px; color:#777; }
    @media(max-width:768px){ nav ul{display:none;} .pakete{grid-template-columns:1fr;} }
